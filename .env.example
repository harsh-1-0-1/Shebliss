# =============================================================================
# Shebliss E-commerce — Root Environment Example
# =============================================================================
# Copy this file to .env and fill in real values before running docker-compose.
#
#   cp .env.example .env
#
# Docker Compose reads the .env file in the same directory as docker-compose.yml
# (i.e. this root folder). The backend and frontend containers receive these
# vars either as environment: entries or as build args — see docker-compose.yml.
#
# Secrets/values marked REQUIRED must be set. Everything else has a safe default.
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-strong-db-password    # REQUIRED in production


# -----------------------------------------------------------------------------
# Container Port Bindings  (host-side — bound to 127.0.0.1 only)
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8090


# -----------------------------------------------------------------------------
# Application Runtime
# -----------------------------------------------------------------------------
# Options: development | staging | production
ENVIRONMENT=production

# true / false
DEBUG=false

# Return HTTP 503 for all requests (maintenance window)
MAINTENANCE=false

# Structured JSON logs (recommended for production)
LOG_JSON=true

# Log SQL queries slower than this threshold (ms)
SLOW_QUERY_MS=100


# -----------------------------------------------------------------------------
# Security & JWT
# -----------------------------------------------------------------------------
# REQUIRED — generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# Backend public-facing URL — used for OAuth callbacks and webhook URLs
BACKEND_PUBLIC_URL=https://api.example.com

# Comma-separated allowed CORS origins
CORS_ORIGINS=https://example.com,https://www.example.com

# Optional: regex pattern for dynamic allowed origins (e.g. PR preview URLs)
CORS_ORIGIN_REGEX=


# -----------------------------------------------------------------------------
# Cloudflare — General / CDN
# -----------------------------------------------------------------------------
# CDN base URL for serving uploaded media.
# - With Cloudflare R2: set this to your public custom domain, e.g. https://cdn.example.com
#   (must be connected to your R2 bucket in the Cloudflare dashboard)
# - With AWS CloudFront: set to your CloudFront distribution URL
# - Leave blank to fall back to local /static/ serving (dev only)
CDN_BASE_URL=https://cdn.example.com


# -----------------------------------------------------------------------------
# Cloudflare R2  (recommended over AWS S3 — zero egress fees)
# -----------------------------------------------------------------------------
# How to set up R2:
#   1. Go to Cloudflare Dashboard → R2 → Create bucket
#   2. Bucket name → paste into AWS_S3_BUCKET
#   3. Manage R2 API Tokens → Create token (Object Read & Write on this bucket)
#      → paste Access Key ID and Secret Access Key below
#   4. In R2 bucket settings → Custom Domains → connect your CDN domain
#      → paste that domain into CDN_BASE_URL above
#   5. Account ID is in the right sidebar of the Cloudflare dashboard
#
# AWS_ prefix is intentional — R2 is S3-compatible and uses the same env names.
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   # REQUIRED for R2
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>                                 # REQUIRED
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>                         # REQUIRED
AWS_S3_BUCKET=<YOUR_BUCKET_NAME>                                     # REQUIRED
AWS_REGION=auto                                                       # R2 ignores this; keep "auto"


# -----------------------------------------------------------------------------
# Cloudflare Access / Origin Protection  (optional but recommended)
# -----------------------------------------------------------------------------
# If your origin is protected by Cloudflare Access or a shared secret header,
# enable this to reject requests that don't carry the secret (prevents bypass).
#
# How to set up:
#   1. In Cloudflare → Workers & Pages (or your reverse-proxy config) add a
#      custom header, e.g. X-CloudFront-Secret: <random value>
#   2. Set REQUIRE_CLOUDFRONT=true and paste the same value in CLOUDFRONT_SECRET
#
# Note: the variable is named CLOUDFRONT_SECRET for historical reasons but works
# with any CDN/proxy that can forward a custom header.
REQUIRE_CLOUDFRONT=false
CLOUDFRONT_SECRET=                                                    # REQUIRED when REQUIRE_CLOUDFRONT=true


# -----------------------------------------------------------------------------
# AWS S3  (alternative to Cloudflare R2 — leave blank if using R2)
# -----------------------------------------------------------------------------
# If you prefer AWS S3, comment out the R2 block above and fill these in.
# AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=<YOUR_BUCKET_NAME>
# AWS_S3_ENDPOINT_URL=                   # leave blank for native S3


# -----------------------------------------------------------------------------
# Cloudinary  (legacy — not recommended for new deployments)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# Google OAuth  (optional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback


# -----------------------------------------------------------------------------
# Razorpay Payments
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx        # REQUIRED for checkout
RAZORPAY_KEY_SECRET=                          # REQUIRED
RAZORPAY_WEBHOOK_SECRET=                      # REQUIRED — set in Razorpay dashboard


# -----------------------------------------------------------------------------
# WhatsApp Business API  (optional — for order notifications)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_RECIPIENT=               # Your WhatsApp number to receive order alerts
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ORDER_TEMPLATE_NAME=new_order_received
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en_US


# -----------------------------------------------------------------------------
# Email / SMTP  (optional — for transactional emails)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shebliss
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ADMIN_ORDER_EMAIL=                      # Receives a copy of every new order email


# -----------------------------------------------------------------------------
# Frontend Build Args  (Vite — baked in at docker build time)
# -----------------------------------------------------------------------------
# Backend API prefix. With the Nginx reverse proxy in this compose setup,
# /api/v1 hits the backend container transparently.
VITE_API_BASE_URL=/api/v1

# Razorpay publishable key (safe to expose — it's a public key)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# CDN base URL forwarded to the frontend for building image src URLs.
# Should match CDN_BASE_URL above.
VITE_CDN_BASE_URL=https://cdn.example.com

# Optional: custom corporate inquiry webhook endpoint
VITE_CORPORATE_INQUIRY_ENDPOINT=


# =============================================================================
# Local Development Overrides
# =============================================================================
# When running docker-compose.dev.yml (Postgres + Redis only, backend via uv):
#
# ENVIRONMENT=development
# DEBUG=true
# LOG_JSON=false
# SECRET_KEY=dev-only-not-secret
# BACKEND_PUBLIC_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=postgresql+asyncpg://ecommerce:ecommerce@localhost:5432/ecommerce
# REDIS_URL=redis://localhost:6379
#
# R2 / S3 — leave blank locally to use filesystem uploads (/static/)
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# CDN_BASE_URL=
# VITE_CDN_BASE_URL=
# =============================================================================
