# =============================================================================
# Shebliss E-commerce Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# This file contains all variables needed for docker-compose.yml deployment.
#
# For local development, also configure:
#   - backend/.env (overrides backend/.env.dev)
#   - frontend/.env (for Vite dev server)
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce

# -----------------------------------------------------------------------------
# Application Ports (Docker Host Binding)
# -----------------------------------------------------------------------------
# Backend API port (exposed on localhost only)
BACKEND_PORT=8000

# Frontend port (exposed on localhost only)
FRONTEND_PORT=8090

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=production

# Enable debug mode (true/false)
DEBUG=false

# Enable maintenance mode (true/false) - returns 503 for all requests
MAINTENANCE=false

# Enable JSON logging for production (true/false)
LOG_JSON=true

# Log slow database queries (milliseconds threshold)
SLOW_QUERY_MS=100

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# CRITICAL: Generate a strong random secret key for production
# Example: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key

# JWT token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# Backend public URL (used for OAuth callbacks, webhooks, etc.)
BACKEND_PUBLIC_URL=https://api.example.com

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=https://example.com,https://www.example.com

# Optional: Regex pattern for allowed origins
CORS_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# CloudFront Protection (Optional)
# -----------------------------------------------------------------------------
# Require CloudFront secret header (true/false)
REQUIRE_CLOUDFRONT=false

# CloudFront shared secret for header validation
CLOUDFRONT_SECRET=

# -----------------------------------------------------------------------------
# CDN Configuration (Optional)
# -----------------------------------------------------------------------------
# Base URL for CDN (for serving static assets)
# For R2: Set this to your custom domain (e.g., https://cdn.example.com)
# Images are served from this URL + the storage key (e.g., store/products/...)
CDN_BASE_URL=

# -----------------------------------------------------------------------------
# Image Optimization (Automatic with R2/CDN)
# -----------------------------------------------------------------------------
# The backend automatically:
# - Converts uploaded images to WebP (25-50% smaller than JPEG/PNG)
# - Generates responsive variants: 400w, 800w, 1200w
# - Sets Cache-Control: public, max-age=31536000, immutable (1 year)
# - Cloudflare CDN caches at edge for 1 month
#
# Frontend uses <picture> with srcset to serve the smallest variant
# that looks crisp for the viewport (saves ~95% bandwidth on mobile).

# -----------------------------------------------------------------------------
# File Upload Provider (Choose one: AWS S3 or Cloudflare R2)
# -----------------------------------------------------------------------------
# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# For Cloudflare R2 (S3-compatible, zero egress fees):
# 1. Set AWS_S3_ENDPOINT_URL to: https://<account_id>.r2.cloudflarestorage.com
# 2. Use R2 Access Key ID and Secret Access Key (from R2 dashboard)
# 3. Set AWS_S3_BUCKET to your R2 bucket name
# 4. Set CDN_BASE_URL to your public R2 domain (e.g., https://images.example.com)
# 5. AWS_REGION is ignored by R2 but keep it set to "auto" or "us-east-1"
AWS_S3_ENDPOINT_URL=

# Cloudinary Configuration (Legacy alternative - not recommended for new deployments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# WhatsApp Business API (Optional)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_RECIPIENT=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ORDER_TEMPLATE_NAME=new_order_received
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en_US

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shebliss
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Admin email for order notifications
ADMIN_ORDER_EMAIL=

# -----------------------------------------------------------------------------
# Frontend Build Variables (Vite)
# -----------------------------------------------------------------------------
# API endpoint for frontend (injected at build time)
# For production with reverse proxy: /api/v1
# For direct backend access: https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Razorpay public key for frontend checkout
VITE_RAZORPAY_KEY_ID=

# CDN base URL for frontend assets
VITE_CDN_BASE_URL=

# Corporate inquiry endpoint (optional)
VITE_CORPORATE_INQUIRY_ENDPOINT=

# =============================================================================
# Development Override Examples
# =============================================================================
# For local development with docker-compose.dev.yml, use these values:
#
# ENVIRONMENT=development
# DEBUG=true
# BACKEND_PUBLIC_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
# SECRET_KEY=dev-only-change-me
# LOG_JSON=false
# VITE_API_BASE_URL=/api/v1
#
# Database and Redis will be on localhost:5433 and localhost:6379
# =============================================================================
