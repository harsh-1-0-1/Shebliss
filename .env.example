# =============================================================================
# Shebliss E-commerce — Production Environment Example
# Domain: https://sheblissfashion.com
# Save on the server as: /opt/myapp/Shebliss/Shebliss/.env  (next to docker-compose.yml)
# =============================================================================
#   cp .env.example .env    then replace every <...> and change-me value.
#
# Docker Compose reads this file and passes the values into the backend
# container (environment:) and the frontend build (build args).
# After editing: docker compose up -d --build
# Never commit the real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=shebliss
POSTGRES_USER=shebliss
# REQUIRED: a strong password. Avoid @ : / # in it (it is used inside DATABASE_URL).
# Generate one with: openssl rand -hex 24
# Changing it later: Postgres keeps the old password in its data volume, so first run
#   docker compose exec postgres psql -U shebliss -d shebliss -c "ALTER USER shebliss PASSWORD 'new';"
POSTGRES_PASSWORD=change-me-strong-db-password

# -----------------------------------------------------------------------------
# Application Ports (Docker host binding, 127.0.0.1 only)
# 8000/8090 are taken by other apps on the VPS (plantoga), so Shebliss uses 8001/8091.
# The host nginx (Hestia) vhost for sheblissfashion.com proxies to FRONTEND_PORT.
# -----------------------------------------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=8091

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Options: development | staging | production
ENVIRONMENT=production
DEBUG=false
# true returns HTTP 503 for every request (maintenance window)
MAINTENANCE=false
LOG_JSON=true
# Log SQL queries slower than this (ms)
SLOW_QUERY_MS=100

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# REQUIRED: generate with  openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# Used for OAuth callbacks, webhook URLs and local /static image links
BACKEND_PUBLIC_URL=https://sheblissfashion.com
# Used for canonical links, sitemap.xml and robots.txt (must be https)
SITE_URL=https://sheblissfashion.com

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://sheblissfashion.com,https://www.sheblissfashion.com
# Optional regex for extra allowed origins (e.g. preview URLs)
CORS_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# Origin Protection (Optional)
# -----------------------------------------------------------------------------
# When true, every request except /api/v1/health must carry the header
# X-Origin-Verify: <CLOUDFRONT_SECRET>. Named after CloudFront, but works with any
# proxy that can add a header (e.g. a Cloudflare Transform Rule). Keep false
# unless that header is configured, or the site will return 403.
REQUIRE_CLOUDFRONT=false
CLOUDFRONT_SECRET=

# -----------------------------------------------------------------------------
# CDN Configuration (Cloudflare)
# -----------------------------------------------------------------------------
# Public custom domain connected to the R2 bucket, INCLUDING https://
# (R2 → bucket → Settings → Custom Domains). Do not use the pub-xxxx.r2.dev URL:
# it is rate-limited and not cached. Leave blank to serve images from /static/.
#
# Image links use this whenever it is set. If the R2 keys below are set but this
# is blank, admin image uploads are refused (503) so no image gets a broken link.
#
# Switching an existing site to R2 (order matters):
#   1. Fill in the R2 keys below, keep CDN_BASE_URL and VITE_CDN_BASE_URL blank,
#      then: docker compose up -d backend
#   2. Copy already-uploaded images into the bucket:
#      docker compose exec backend uv run python -m scripts.upload_static_to_r2 --dry-run
#      docker compose exec backend uv run python -m scripts.upload_static_to_r2
#   3. Set CDN_BASE_URL and VITE_CDN_BASE_URL, then:
#      docker compose up -d --build backend frontend
#   4. Clear cached product lists: docker compose exec redis redis-cli FLUSHDB
#   5. Cloudflare → Caching → Cache Rules: make the CDN hostname eligible for cache
#      and respect origin Cache-Control (uploads carry a 1-year immutable header).
CDN_BASE_URL=https://cdn.sheblissfashion.com

# -----------------------------------------------------------------------------
# File Upload Storage: Cloudflare R2 (S3-compatible, uses the AWS_* names)
# -----------------------------------------------------------------------------
# 1. Cloudflare → R2 → Create bucket → name goes in AWS_S3_BUCKET
# 2. R2 → Manage API tokens → Create Account API token (Object Read & Write on that
#    bucket) → Access Key ID / Secret Access Key go below (shown only once)
# 3. Endpoint = the bucket's "S3 API" URL WITHOUT the trailing /<bucket-name>
# Uploads go to R2 whenever these are set; otherwise they are saved to
# backend/static/ (refused with 503 when ENVIRONMENT=production).
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
AWS_S3_BUCKET=sheblissimages
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 ignores the region; keep "auto"
AWS_REGION=auto

# For AWS S3 instead of R2: leave AWS_S3_ENDPOINT_URL blank and set a real region,
# e.g. AWS_REGION=ap-south-1.

# Cloudinary (legacy, not used by current uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sheblissfashion.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
# REQUIRED for checkout
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set the same value on the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# WhatsApp Business API (Optional, order notifications)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your WhatsApp number that receives order alerts
WHATSAPP_ADMIN_RECIPIENT=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ORDER_TEMPLATE_NAME=new_order_received
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en_US

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shebliss
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Receives a copy of every new order email
ADMIN_ORDER_EMAIL=

# -----------------------------------------------------------------------------
# Frontend Build Variables (Vite) - baked in at build time
# Rebuild after changing: docker compose up -d --build frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# Razorpay PUBLIC key id (same as RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Same value as CDN_BASE_URL, including https://
VITE_CDN_BASE_URL=https://cdn.sheblissfashion.com
VITE_CORPORATE_INQUIRY_ENDPOINT=


# =============================================================================
# Local Development (backend/.env, not this file)
# =============================================================================
# With backend/docker-compose.dev.yml (Postgres + Redis only, backend via uv):
#
# ENVIRONMENT=development
# DEBUG=true
# LOG_JSON=false
# SECRET_KEY=dev-only-not-secret
# BACKEND_PUBLIC_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=postgresql+asyncpg://ecommerce:ecommerce@localhost:5433/ecommerce
# REDIS_URL=redis://localhost:6380
#
# Leave the AWS_* and CDN values blank locally to save uploads in backend/static/.
# =============================================================================
